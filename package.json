{
  "name": "iyer-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:export": "node scripts/check-export.mjs",
    "format": "prettier --write src content/data content/text scripts README.md docs .github/workflows/deploy.yml",
    "format:check": "prettier --check src content/data content/text scripts README.md docs .github/workflows/deploy.yml",
    "cms:import": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-content.ts",
    "cms:backup": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backup-content.ts",
    "cms:restore": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/restore-content.ts",
    "cms:check": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-permissions.ts",
    "cms:types": "supabase gen types typescript --local --schema public > src/lib/cms/database.types.ts && prettier --write src/lib/cms/database.types.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "marked": "^18.1.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.1.2",
    "prettier": "^3.9.10",
    "supabase": "2.120.0",
    "typescript": "^5.9.0"
  }
}
