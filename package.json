{
  "name": "iyer-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:export": "node scripts/check-export.mjs",
    "format": "prettier --write src content/data content/text scripts README.md docs .github/workflows/deploy.yml",
    "format:check": "prettier --check src content/data content/text scripts README.md docs .github/workflows/deploy.yml"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "marked": "^18.1.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cheerio": "^1.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
